{
  "name": "shelter-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shelter-web/src",
  "projectType": "application",
  "tags": ["type:app", "scope:shelter-web"],
  "targets": {
    "test": {
      "options": {},
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      },
      "dependsOn": ["privacy-test"]
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/shared/**/*",
        {
          "fileset": "{projectRoot}/.env*",
          "includeIgnored": true
        },
        {
          "env": "CI"
        },
        {
          "env": "BRANCH_NAME"
        },
        {
          "env": "VITE_APP_BASE_PATH"
        },
        {
          "env": "VITE_SHELTER_API_URL"
        },
        {
          "env": "VITE_SHELTER_GOOGLE_MAPS_API_KEY"
        },
        {
          "env": "VITE_POSTHOG_API_KEY"
        },
        {
          "env": "VITE_POSTHOG_E2E"
        },
        {
          "env": "VITE_SHELTER_WEB_NEW_RELIC_LICENSE_KEY"
        },
        {
          "env": "VITE_APP_ENV"
        },
        {
          "env": "APP_VERSION"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/shelter-web"],
      "options": {
        "command": "vite build",
        "cwd": "apps/shelter-web"
      },
      "configurations": {
        "preview": {
          "env": {
            "VITE_POSTHOG_E2E": "true"
          }
        },
        "production": {}
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build", "privacy-test"],
      "options": {
        "command": "node tools/deploy/cloudfront-deploy.mjs"
      },
      "configurations": {
        "production": {},
        "preview": {}
      }
    },
    "post-pr-preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/post-preview-comment.js --url=https://shelter.dev.betterangels.la"
      }
    },
    "privacy-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "esbuild apps/shelter-web/src/monitoring/privacy.node-test.ts --bundle --platform=node --outfile=dist/privacy-tests/shelter-web/privacy.node-test.cjs && node --test dist/privacy-tests/shelter-web/privacy.node-test.cjs"
      },
      "outputs": [
        "{workspaceRoot}/dist/privacy-tests/shelter-web/privacy.node-test.cjs"
      ],
      "inputs": [
        "sharedGlobals",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/src/monitoring/**/*",
        "{workspaceRoot}/libs/monitoring/**/*",
        {
          "externalDependencies": ["@newrelic/browser-agent", "esbuild"]
        }
      ]
    }
  }
}
