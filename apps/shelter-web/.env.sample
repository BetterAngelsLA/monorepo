# only Vars prefixed with `VITE_` will be available on to the client
VITE_SHELTER_API_URL=http://localhost:8000
VITE_SHELTER_GOOGLE_MAPS_API_KEY=fill-in-with-your-maps-key

# PostHog (optional). Leave the token empty to run without analytics — the page
# still works and the handoff fragment is still stripped from the URL.
# The token is the project's public one, not a personal API key: it is inlined
# into the bundle.
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

