# only Vars prefixed with `VITE_` will be available on to the client
VITE_SHELTER_API_URL=http://localhost:8000
VITE_SHELTER_GOOGLE_MAPS_API_KEY=fill-in-with-your-maps-key

# Optional locally; required for deployed CI builds. Public Browser key only.
VITE_SHELTER_WEB_NEW_RELIC_LICENSE_KEY=
VITE_APP_ENV=

# APP_VERSION is passed by CI (commit SHA); local builds report "local".
