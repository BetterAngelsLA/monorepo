{
  "name": "betterangels",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/betterangels/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:betterangels"
  ],
  "targets": {
    "export-web": {
      "executor": "@nx/expo:export",
      "cache": true,
      "dependsOn": [
        "sync-deps",
        "base-path"
      ],
      "options": {
        "platform": "web",
        "outputDir": "dist/apps/betterangels",
        "clear": true
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/betterangels"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/shared/**/*",
        {
          "fileset": "{projectRoot}/.env.local",
          "includeIgnored": true
        },
        {
          "env": "CI"
        },
        {
          "env": "BRANCH_NAME"
        },
        {
          "env": "VITE_APP_BASE_PATH"
        },
        {
          "env": "EXPO_PUBLIC_API_URL"
        },
        {
          "env": "EXPO_PUBLIC_DEMO_API_URL"
        },
        {
          "env": "EXPO_PUBLIC_SHELTER_WEB_URL"
        },
        {
          "env": "APP_VARIANT"
        },
        {
          "env": "EXPO_PUBLIC_APP_ENV"
        },
        {
          "env": "EXPO_PUBLIC_NEW_RELIC_LOG_LEVEL"
        },
        {
          "env": "EXPO_PUBLIC_WEB_GOOGLEMAPS_JS_APIKEY"
        }
      ]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "export-web"
      ],
      "options": {
        "command": "node tools/deploy/cloudfront-deploy.mjs"
      },
      "configurations": {
        "preview": {
          "envFile": "apps/betterangels/.env.deploy.preview"
        },
        "production": {
          "envFile": "apps/betterangels/.env.deploy.production"
        }
      }
    },
    "post-pr-preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "deploy"
      ],
      "options": {
        "command": "node tools/scripts/post-preview-comment.js --url=https://outreach.dev.betterangels.la"
      },
      "configurations": {
        "preview": {},
        "production": {}
      }
    },
    "preview-comment": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/scripts/eas-preview-comment.mjs --project betterangels --account better-angels --slug betterangels --projectId 53171ba4-60ca-40cb-b3e6-b0c2393677b8"
      }
    },
    "eas-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/eas-e2e.ts --project betterangels"
      }
    },
    "test": {
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/betterangels",
        "commands": [
          {
            "command": "tsc --noEmit -p tsconfig.app.json"
          },
          {
            "command": "tsc --noEmit -p tsconfig.spec.json"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/betterangels/**/*.{ts,tsx,js,jsx}"
        ]
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "ios",
      "options": {
        "cwd": "apps/betterangels"
      },
      "configurations": {
        "ios": {
          "command": ".maestro/scripts/setup-maestro.sh",
          "env": {
            "MAESTRO_PLATFORM": "ios"
          }
        },
        "android": {
          "command": ".maestro/scripts/setup-maestro.sh",
          "env": {
            "MAESTRO_PLATFORM": "android"
          }
        }
      }
    },
    "copy-lockfile": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/scripts/eas-build-pre-install.mjs . apps/betterangels"
      }
    },
    "sync-deps": {
      "executor": "@nx/expo:sync-deps",
      "options": {},
      "cache": false
    },
    "expo-doctor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../tools/scripts/expo-doctor-check.mjs apps/betterangels",
        "cwd": "apps/betterangels"
      }
    },
    "restore-workspace": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/scripts/restore-workspace.mjs --project betterangels"
      }
    },
    "eas-update": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "copy-lockfile"
      ],
      "options": {
        "command": "node tools/scripts/eas-update.mjs --project betterangels --profile preview"
      },
      "configurations": {
        "preview": {
          "command": "node tools/scripts/eas-update.mjs --project betterangels --profile preview"
        },
        "production": {
          "command": "node tools/scripts/eas-update.mjs --project betterangels --profile production"
        }
      }
    },
    "ensure-symlink": {
      "executor": "@nx/expo:ensure-symlink"
    },
    "build-list": {
      "executor": "@nx/expo:build-list"
    },
    "base-path": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/scripts/write-base-url.mjs"
      }
    },
    "build-missing": {
      "cache": false
    }
  }
}
