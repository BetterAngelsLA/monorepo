{
  "name": "betterangels",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/betterangels/src",
  "projectType": "application",
  "tags": ["type:app", "scope:betterangels"],
  "targets": {
    "start": {
      "command": "expo start --port 8081",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps"]
    },
    "serve": {
      "command": "expo start --web",
      "options": {
        "cwd": "apps/betterangels"
      }
    },
    "run-ios": {
      "command": "expo run:ios",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps"]
    },
    "run-android": {
      "command": "expo run:android",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps"]
    },
    "build-list": {
      "command": "eas build:list",
      "options": {
        "cwd": "apps/betterangels"
      }
    },
    "eas-build": {
      "command": "eas build",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps", "copy-lockfile"]
    },
    "prebuild": {
      "command": "expo prebuild --no-install",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps"]
    },
    "eas-update": {
      "command": "eas update",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps", "copy-lockfile"]
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "preview",
      "configurations": {
        "preview": {
          "command": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/eas-deploy.ts --project betterangels --profile preview"
        },
        "production": {
          "command": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/eas-deploy.ts --project betterangels --profile production"
        }
      }
    },
    "export": {
      "outputs": [
        "{projectRoot}/{options.outputDir}",
        "{workspaceRoot}/apps/betterangels/dist"
      ],
      "options": {
        "outputDir": "../../dist/apps/betterangels",
        "platform": "all"
      },
      "dependsOn": ["sync-deps"]
    },
    "export-web": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "preview",
      "outputs": ["{workspaceRoot}/dist/apps/betterangels"],
      "options": {
        "command": "EXPO_BASE_URL=$(node ../../tools/shared/print-base-path.mjs) expo export --platform web --clear --output-dir ../../dist/apps/betterangels",
        "cwd": "apps/betterangels"
      },
      "configurations": {
        "preview": {
          "env": {
            "EXPO_PUBLIC_API_URL": "https://api.dev.betterangels.la",
            "EXPO_PUBLIC_DEMO_API_URL": "https://api.dev.betterangels.la",
            "EXPO_PUBLIC_SHELTER_WEB_URL": "https://shelter.dev.betterangels.la"
          }
        },
        "production": {
          "env": {
            "APP_VARIANT": "production",
            "EXPO_PUBLIC_APP_ENV": "production",
            "EXPO_PUBLIC_NEW_RELIC_LOG_LEVEL": "WARN",
            "EXPO_PUBLIC_API_URL": "https://api.prod.betterangels.la",
            "EXPO_PUBLIC_DEMO_API_URL": "https://api.dev.betterangels.la",
            "EXPO_PUBLIC_SHELTER_WEB_URL": "https://shelter.betterangels.la"
          }
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["export-web"],
      "options": {
        "command": "node tools/deploy/cloudfront-deploy.mjs"
      },
      "configurations": {
        "preview": {},
        "production": {}
      }
    },
    "post-pr-preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/post-preview-comment.js --url=https://outreach.dev.betterangels.la"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/betterangels",
        "commands": [
          {
            "command": "tsc --noEmit -p tsconfig.app.json"
          },
          {
            "command": "tsc --noEmit -p tsconfig.spec.json"
          }
        ]
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "ios",
      "options": {
        "cwd": "apps/betterangels"
      },
      "configurations": {
        "ios": {
          "command": ".maestro/scripts/setup-maestro.sh",
          "env": {
            "MAESTRO_PLATFORM": "ios"
          }
        },
        "android": {
          "command": ".maestro/scripts/setup-maestro.sh",
          "env": {
            "MAESTRO_PLATFORM": "android"
          }
        }
      }
    },
    "eas-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ts-node --project tools/tsconfig.tools.json tools/scripts/eas-e2e.ts --project betterangels"
      }
    },
    "copy-lockfile": {
      "command": "node tools/scripts/eas-build-pre-install.mjs . apps/betterangels"
    },
    "sync-deps": {
      "executor": "@nx/expo:sync-deps",
      "options": {}
    },
    "expo-doctor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../tools/scripts/expo-doctor-check.mjs apps/betterangels",
        "cwd": "apps/betterangels"
      }
    }
  }
}
