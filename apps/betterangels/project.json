{
  "name": "betterangels",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/betterangels/src",
  "projectType": "application",
  "tags": ["type:app", "scope:betterangels"],
  "targets": {
    "start": {
      "command": "expo start --port 8081",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps"]
    },
    "serve": {
      "command": "expo start --web",
      "options": {
        "cwd": "apps/betterangels"
      }
    },
    "run-ios": {
      "command": "expo run:ios",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps"]
    },
    "run-android": {
      "command": "expo run:android",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps"]
    },
    "prebuild": {
      "command": "expo prebuild --no-install",
      "options": {
        "cwd": "apps/betterangels"
      },
      "dependsOn": ["sync-deps"]
    },
    "export": {
      "outputs": [
        "{projectRoot}/{options.outputDir}",
        "{workspaceRoot}/apps/betterangels/dist"
      ],
      "options": {
        "outputDir": "../../dist/apps/betterangels",
        "platform": "all"
      },
      "dependsOn": ["sync-deps"]
    },
    "export-web": {
      "executor": "@nx/expo:export",
      "cache": true,
      "dependsOn": ["write-eas-env", "sync-deps", "copy-lockfile"],
      "options": {
        "platform": "web",
        "outputDir": "dist/apps/betterangels",
        "clear": true
      },
      "outputs": ["{workspaceRoot}/dist/apps/betterangels"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/shared/**/*",
        {
          "env": "CI"
        },
        {
          "env": "BRANCH_NAME"
        },
        {
          "env": "EXPO_BASE_URL"
        },
        {
          "env": "VITE_APP_BASE_PATH"
        },
        {
          "env": "EXPO_PUBLIC_API_URL"
        },
        {
          "env": "EXPO_PUBLIC_DEMO_API_URL"
        },
        {
          "env": "EXPO_PUBLIC_LOCAL_API_URL"
        },
        {
          "env": "EXPO_PUBLIC_SHELTER_WEB_URL"
        },
        {
          "env": "APP_VARIANT"
        },
        {
          "env": "EXPO_PUBLIC_APP_ENV"
        },
        {
          "env": "EXPO_PUBLIC_NEW_RELIC_LOG_LEVEL"
        },
        {
          "env": "EXPO_PUBLIC_WEB_GOOGLEMAPS_JS_APIKEY"
        }
      ],
      "configurations": {
        "preview": {},
        "production": {}
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["export-web"],
      "options": {
        "command": "node tools/deploy/cloudfront-deploy.mjs"
      },
      "configurations": {
        "preview": {},
        "production": {}
      }
    },
    "post-pr-preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["deploy"],
      "options": {
        "command": "node tools/scripts/post-preview-comment.js --url=https://outreach.dev.betterangels.la"
      },
      "configurations": {
        "preview": {},
        "production": {}
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/betterangels",
        "commands": [
          {
            "command": "tsc --noEmit -p tsconfig.app.json"
          },
          {
            "command": "tsc --noEmit -p tsconfig.spec.json"
          }
        ]
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "ios",
      "options": {
        "cwd": "apps/betterangels"
      },
      "configurations": {
        "ios": {
          "command": ".maestro/scripts/setup-maestro.sh",
          "env": {
            "MAESTRO_PLATFORM": "ios"
          }
        },
        "android": {
          "command": ".maestro/scripts/setup-maestro.sh",
          "env": {
            "MAESTRO_PLATFORM": "android"
          }
        }
      }
    },
    "copy-lockfile": {
      "command": "node tools/scripts/eas-build-pre-install.mjs . apps/betterangels",
      "cache": false
    },
    "sync-deps": {
      "executor": "@nx/expo:sync-deps",
      "options": {},
      "cache": false
    },
    "expo-doctor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../tools/scripts/expo-doctor-check.mjs apps/betterangels",
        "cwd": "apps/betterangels"
      }
    },
    "write-eas-env": {
      "executor": "nx:run-commands",
      "cache": false,
      "configurations": {
        "preview": {
          "command": "node tools/scripts/write-eas-env.mjs --project betterangels --profile preview"
        },
        "production": {
          "command": "node tools/scripts/write-eas-env.mjs --project betterangels --profile production"
        }
      }
    },
    "eas-update": {
      "executor": "@nx/expo:update",
      "cache": false,
      "dependsOn": ["write-eas-env", "sync-deps", "copy-lockfile"],
      "options": {},
      "configurations": {
        "preview": {
          "auto": true
        },
        "production": {
          "auto": true
        }
      }
    }
  }
}
