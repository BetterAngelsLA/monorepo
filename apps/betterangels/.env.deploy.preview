S3_BUCKET=development-us-west-2-outreach-web
CF_DISTRIBUTION_ID=E18T6D6MTJ5IDH
ASSUME_ROLE=arn:aws:iam::784154756963:role/github-actions-deploy

# Both values come from the site's own unit:
#
#   cd infrastructure/environments/development/us-west-2/static-sites/outreach-web
#   terragrunt output -raw s3_bucket_id
#   terragrunt output -raw cloudfront_distribution_id
#
# The bucket + distribution were applied 2026-10-09. CF_DISTRIBUTION_ID is
# assigned by AWS at creation, so unlike S3_BUCKET it cannot be written in
# advance — re-read it if the distribution is ever replaced.
#
# S3_BUCKET and ASSUME_ROLE match the sibling apps — same naming scheme, same
# per-environment deploy role — so nothing new has to be created for outreach.
