{
  "build": {
    "base": {
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      },
      "node": "22.21.1"
    },
    "development-simulator": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": true,
      "environment": "development"
    },
    "production": {
      "extends": "base",
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6468135540"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  },
  "cli": {
    "version": ">= 5",
    "appVersionSource": "local"
  }
}
