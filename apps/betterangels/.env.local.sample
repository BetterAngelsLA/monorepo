# The two deployed/API hosts the app talks to. **These stay direct API URLs**:
# they are what native uses, and one Metro serves both the web and the native
# bundles, so `EXPO_PUBLIC_*` ends up inlined in the iOS/Android bundle too. A
# dev-server URL here reaches the phone and the app talks to Metro instead of the
# API (see "Running the web dev server against a deployed API" below).
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEMO_API_URL=http://localhost:8000

# Local Django (nx serve betterangels-backend). Optional — unset is the normal
# case, and the `local` environment disappears from the switcher with it.
# From the iOS **simulator** `localhost` is the Mac, so it resolves; a physical
# device needs the Mac's LAN IP instead (e.g. http://192.168.1.198:8000).
# Never set this in a deployed build.
EXPO_PUBLIC_LOCAL_API_URL=http://localhost:8000

# ------------------------------------------------------------------
# Migrating an .env.local that pointed EXPO_PUBLIC_* at the dev proxy
# ------------------------------------------------------------------
# The `__api` prefix used to live in these variables. It does not any more: the
# browser adds it, and only in a web dev build. Move back to the direct URLs and
# delete BA_DEV_PROXY_TARGETS — the proxy now derives its targets from the three
# variables above:
#
#   EXPO_PUBLIC_API_URL=http://localhost:8081/__api/production   -> EXPO_PUBLIC_API_URL=https://api.betterangels.la
#   EXPO_PUBLIC_DEMO_API_URL=http://localhost:8081/__api/demo    -> EXPO_PUBLIC_DEMO_API_URL=https://api.dev.betterangels.la
#   BA_DEV_PROXY_TARGETS=...                                     -> (drop it; only needed to add/override a target)
#
# A derived value that still carries `/__api` is ignored with a warning rather
# than forwarded to itself, but the same value would still be baked into the
# native bundle — check both variables, and restart the dev server.

# Public shelter-web host for the "View in Shelter Directory" link. Unset hides
# the link instead of pointing it at a wrong destination.
#
# Must match the backend this .env points at, or the link crosses environments:
#   local dev server (nx serve shelter-web) -> http://localhost:8083
#   dev/preview backends                    -> https://shelter.dev.betterangels.la
#   production                              -> https://shelter.betterangels.la
# The two deployed values are set per build profile in eas.json.
EXPO_PUBLIC_SHELTER_WEB_URL=http://localhost:8083

# ------------------------------------------------------------------
# Api request/response debug logging
# ------------------------------------------------------------------
EXPO_PUBLIC_API_DEBUG=true/false # logs API requests/responses (Apollo + HMIS prod REST) to the dev console
EXPO_PUBLIC_API_DEBUG_MAX_CHARS=500 # max chars to log before truncating
EXPO_PUBLIC_API_DEBUG_EXPANDED=true/false # if true, log fully expanded

# ------------------------------------------------------------------
# Bottom sheet lifecycle tracing (verbose, off by default)
# ------------------------------------------------------------------
# Level 1: logs the sheet lifecycle
# Level 2: logs L1 + Gorhom's internal trace to the dev console (reload after changing)
EXPO_PUBLIC_BOTTOM_SHEET_DEBUG_LEVEL=1 or 2

# Google Maps API keys
# to be retrieved from console.cloud.google APIs & Services Credentials
EXPO_PUBLIC_IOS_GOOGLEMAPS_APIKEY=
EXPO_PUBLIC_ANDROID_GOOGLEMAPS_APIKEY=
EXPO_PUBLIC_WEB_GOOGLEMAPS_JS_APIKEY=

# ------------------------------------------------------------------
# Maestro E2E overrides (optional)
# ------------------------------------------------------------------
# These are auto-detected by resolve-deeplink.sh. Only set if needed.
#
# MAESTRO_DEEPLINK=exp+betterangels://expo-development-client/?url=http://192.168.1.198:8081&disableOnboarding=1
# MAESTRO_EXPO_HOST=192.168.1.198
# MAESTRO_EXPO_PORT=8081
# MAESTRO_DEVICE=

# Login credentials to BA app
# via ba-flow
MAESTRO_BA_USER_EMAIL=admin@example.com
MAESTRO_BA_USER_PASSWORD=password

# Primary use case is to mock expo-camera in e2e tests for iOS simulator.
# Mocking camera prevents the expo implementation from locking up
# and freezing the screen, which causes test failures.
EXPO_PUBLIC_MOCK_EXPO_CAMERA_LOCALLY= # true/false

# ------------------------------------------------------------------
# Running the web dev server against a deployed API (browser only)
# ------------------------------------------------------------------
# A browser cannot call a deployed API directly (CORS + CSRF origin allowlist,
# and the `csrftoken` cookie is scoped to `.dev.betterangels.la`), so a web dev
# build asks the dev server for `<page origin>/__api/<environment>` and the dev
# server forwards that to the API named by the variables above. Nothing to opt
# in to; native and deployed web exports keep using the direct URLs.
#
#   EXPO_PUBLIC_API_URL=https://api.betterangels.la
#   EXPO_PUBLIC_DEMO_API_URL=https://api.dev.betterangels.la
#   yarn nx serve betterangels --clear
#
# The targets are derived from those variables (`production`, `demo`, `local`),
# so the sign-in screen can move between them without a restart: the email
# decides (`+local`, then `+demo`/any `@example.com`, anything else production).
# Each target is namespaced under its own prefix, and the proxy keeps their
# cookies apart.
#
# BA_DEV_PROXY_TARGETS adds or overrides a target — for a second backend that is
# not one of the three environments, or to point one somewhere else:
# BA_DEV_PROXY_TARGETS=production=https://api.betterangels.la,demo=https://api.dev.betterangels.la
#
# `EXPO_PUBLIC_*` are inlined into the bundle at transform time, not read at
# runtime: changing one needs a dev-server restart with `--clear`, or the old
# value keeps being served.
#
# With nothing set the middleware is inert, and /__api answers 502 with a hint.
