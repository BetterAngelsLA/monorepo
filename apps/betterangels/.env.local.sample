EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEMO_API_URL=http://localhost:8000

# Public shelter-web host for the "View in Shelter Directory" link. Unset hides
# the link instead of pointing it at a wrong destination.
#
# Must match the backend this .env points at, or the link crosses environments:
#   local dev server (nx serve shelter-web) -> http://localhost:8083
#   dev/preview backends                    -> https://shelter.dev.betterangels.la
#   production                              -> https://shelter.betterangels.la
# The two deployed values are set per build profile in eas.json.
EXPO_PUBLIC_SHELTER_WEB_URL=http://localhost:8083

# ------------------------------------------------------------------
# Api request/response debug logging
# ------------------------------------------------------------------
EXPO_PUBLIC_API_DEBUG=true/false # logs API requests/responses (Apollo + HMIS prod REST) to the dev console
EXPO_PUBLIC_API_DEBUG_MAX_CHARS=500 # max chars to log before truncating
EXPO_PUBLIC_API_DEBUG_EXPANDED=true/false # if true, log fully expanded

# Google Maps API keys
# to be retrieved from console.cloud.google APIs & Services Credentials
EXPO_PUBLIC_IOS_GOOGLEMAPS_APIKEY=
EXPO_PUBLIC_ANDROID_GOOGLEMAPS_APIKEY=

# Web (react-native-web) browser key — Maps JavaScript API only.
# Restricted by HTTP referrer, NOT by bundle id / package name, so it must be a
# different Google Cloud key from the two above. It is inlined into a public JS
# bundle: keep its API scope to Maps JavaScript API and its referrer allowlist
# to the outreach web hosts (https://outreach.betterangels.la/*,
# https://outreach.dev.betterangels.la/*) plus http://localhost:8081/* for dev.
# Places/geocoding is proxied through the backend and uses GOOGLE_MAPS_API_KEY
# server-side, so this key does not need Places enabled.
EXPO_PUBLIC_WEB_GOOGLEMAPS_JS_APIKEY=

# ------------------------------------------------------------------
# Maestro E2E overrides (optional)
# ------------------------------------------------------------------
# These are auto-detected by resolve-deeplink.sh. Only set if needed.
#
# MAESTRO_DEEPLINK=exp+betterangels://expo-development-client/?url=http://192.168.1.198:8081&disableOnboarding=1
# MAESTRO_EXPO_HOST=192.168.1.198
# MAESTRO_EXPO_PORT=8081
# MAESTRO_DEVICE=

# Login credentials to BA app
# via ba-flow
MAESTRO_BA_USER_EMAIL=admin@example.com
MAESTRO_BA_USER_PASSWORD=password

# Primary use case is to mock expo-camera in e2e tests for iOS simulator.
# Mocking camera prevents the expo implementation from locking up
# and freezing the screen, which causes test failures.
EXPO_PUBLIC_MOCK_EXPO_CAMERA_LOCALLY= # true/false

# ------------------------------------------------------------------
# Running the web build against a deployed API (optional)
# ------------------------------------------------------------------
# A browser cannot call a deployed API directly: the API allows only
# https://*.dev.betterangels.la (CORS + CSRF origin), and its `csrftoken`
# cookie is scoped to `.dev.betterangels.la`, which `document.cookie` on
# localhost can never read. The web dev server proxies the API from its own
# origin to get around all of that — the same trick as Vite's `server.proxy`.
#
# `BA_DEV_PROXY_TARGET` is read by metro.config.js (not the app bundle), so it
# needs the dev server restarted to take effect. `EXPO_PUBLIC_API_URL` is
# inlined into the bundle, so it needs `--clear` on the first build.
#
# Run:
#   BA_DEV_PROXY_TARGET=https://api.dev.betterangels.la \
#   EXPO_PUBLIC_API_URL=http://localhost:8081/__api \
#   yarn nx serve betterangels --clear
#
# Then sign in with any non-@example.com email (see useEmailEnvironment) and the
# app talks to api.dev. Sign in with an @example.com address and it still goes to
# EXPO_PUBLIC_DEMO_API_URL below, so local backend work is unaffected.
#
# Without BA_DEV_PROXY_TARGET the middleware is inert and normal local dev is
# unchanged.
# BA_DEV_PROXY_TARGET=https://api.dev.betterangels.la
# EXPO_PUBLIC_API_URL=http://localhost:8081/__api
