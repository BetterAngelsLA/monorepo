{
  "name": "wildfires",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wildfires/src",
  "projectType": "application",
  "tags": ["type:app", "scope:wildfires"],
  "targets": {
    "test": {
      "options": {},
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "sync-deps": {
      "executor": "@nx/expo:sync-deps",
      "options": {}
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/shared/**/*",
        { "env": "CI" },
        { "env": "BRANCH_NAME" },
        { "env": "VITE_APP_BASE_PATH" }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/wildfires"],
      "options": {
        "command": "vite build",
        "cwd": "apps/wildfires"
      },
      "configurations": {
        "preview": {},
        "production": {
          "mode": "production",
          "env": {
            "VITE_ANALYTICS_ENABLED": "true",
            "VITE_ANALYTICS_ID": "G-3FX73WC6WM"
          }
        },
        "development": {
          "mode": "development",
          "env": {
            "VITE_ANALYTICS_ENABLED": "true",
            "VITE_ANALYTICS_ID": "G-VXGSM2MQXZ"
          }
        }
      }
    }
  }
}
