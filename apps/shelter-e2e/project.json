{
  "name": "shelter-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shelter-e2e/tests",
  "tags": [],
  "implicitDependencies": ["shelter-web"],
  "// targets": "to see all targets run: nx show project shelter-e2e --web",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^deploy"],
      "options": {
        "command": "bash tools/scripts/e2e-shelter.sh"
      },
      "configurations": {
        "preview": {},
        "production": {}
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/shelter-e2e",
        "commands": [
          {
            "command": "tsc --noEmit -p tsconfig.json"
          }
        ]
      }
    }
  }
}
