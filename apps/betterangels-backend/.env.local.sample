# ENV VARS to add to your .env.local in betterangels-backend project

# Google Maps
GOOGLE_MAPS_API_KEY="<your google maps api key>"

# HMIS
HMIS_TOKEN_KEY="" # 'LeUjRutbzg_txpcdszNmKbpX8rFiMWLnpJtPbF2nsS0' random 32-byte key for local encryption
HMIS_API_KEY="<HMIS_API_KEY>"
HMIS_REST_URL="<HMIS_REST_URL>"
HMIS_HOST="<HMIS_HOST>"

# LA Clarity (prod HMIS) — used for allowlisted users when the hmis_prod_demo_enabled switch is active
LA_CLARITY_REST_URL="<LA_CLARITY_REST_URL>"
LA_HMIS_PROD_ALLOWED_EMAILS="" # comma-separated emails, e.g. user1@example.com,user2@example.com
