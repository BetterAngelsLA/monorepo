# POST_OFFICE_EMAIL_BACKEND=django_ses.SESBackend

# Allauth
# Enable login by OTP code
ACCOUNT_LOGIN_BY_CODE_ENABLED=True
# OTP code expiration timeout in seconds (default: 300 = 5 minutes)
ACCOUNT_LOGIN_BY_CODE_TIMEOUT=300

# Google Maps
GOOGLE_MAPS_API_KEY="<GOOGLE_MAPS_API_KEY>"

# Cache
DJANGO_CACHE_URL=redis://valkey:6379/0

# Celery
CELERY_BROKER_URL=redis://valkey:6379/1
CELERY_REDBEAT_URL=redis://localhost:6379/2

# Site Security
CSRF_COOKIE_SECURE=False
# The `Origin` header is the *requesting document's* origin, so browsing the admin at
# http://127.0.0.1:8084 sends `Origin: http://127.0.0.1:8084` — not the API's `:8000`. The
# backend is served on `:8000` through the proxy, so the reasons the entry list carries
# `:8081`/`:8083`/`:8084` are the two admin ports and shelter-web: those are the documents that
# make the cross-origin requests. Both the `localhost` and `127.0.0.1` spellings are listed
# because the session cookie is host-only and the admin's `resolveApiUrl` keeps the API host
# matching the address bar. Django rejects a cross-origin POST from an untrusted origin with
# "CSRF cookie not set". Add a LAN address here too if you browse from another machine.
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:8083,http://localhost:8084,http://127.0.0.1:8081,http://127.0.0.1:8083,http://127.0.0.1:8084
CORS_ALLOW_ALL_ORIGINS=True
ALLOWED_HOSTS="*"
LANGUAGE_COOKIE_SECURE=False
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False

# Media
MEDIA_URL=http://localhost:8000/media/

