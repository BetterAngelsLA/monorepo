  "tags": ["type:util", "scope:shared"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": ["default", "!{projectRoot}/src/testing/**/*"]
  },
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
