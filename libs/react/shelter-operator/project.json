{
  "name": "react-shelter-operator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/react/shelter-operator/src",
  "projectType": "library",
  "tags": ["type:feature", "scope:shelter-operator"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/apps/betterangels-backend/schema.graphql"
    ]
  },
  "targets": {
    "generate-graphql-types": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/libs/react/shelter-operator/src/lib/**/__generated__/"
      ],
      "options": {
        "cwd": "libs/react/shelter-operator",
        "command": "graphql-codegen --config codegen.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/react/shelter-operator",
        // Opts out of composite for this run only: importing shelter through
        // the `paths` alias pulls its sources into the program, which
        // composite's file-list rule rejects (TS6307). No other typecheck
        // target in the repo needs the override; the config keeps composite
        // for the editor — rationale in tsconfig.lib.json.
        "command": "tsc --noEmit --composite false --declaration false -p tsconfig.lib.json"
      }
    },
    "test": {
      "options": {},
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    }
  }
}
