# Add files here to ignore them from prettier formatting
#
# Note: Prettier 3 also reads .gitignore, so anything ignored there is already
# skipped. The entries below cover paths .gitignore does NOT catch — either
# because they're excluded outside the repo (.git/info/exclude, global excludes)
# or because they're deliberately tracked.

# Build / test output. Un-anchored so nested Nx project outputs are covered too.
dist/
coverage/
web-build/
storybook-static/

/.nx/cache
/.nx/workspace-data
.nx/self-healing

# Python tooling. Not in .gitignore, so Prettier would otherwise walk into
# site-packages and fail on Django's Jinja templates.
.venv/
.pytest_cache/
.ruff_cache/

# Yarn Berry vendors its release bundle and SDK wrappers as tracked files
# (see the !.yarn/* un-ignores in .gitignore) — never reformat them.
.yarn/

.expo/
.cache/
tmp/

# Generated schema — regenerated by generate-graphql-schema; exact-diff validated in precommit
apps/betterangels-backend/schema.graphql

# GraphQL codegen output — regenerated by ynx-generate, don't format
**/__generated__/**

# Django templates use {% %} syntax — handled by djlint, not Prettier
**/templates/**/*.html
