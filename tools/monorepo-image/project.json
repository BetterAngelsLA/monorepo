{
  "name": "monorepo-image",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/monorepo-image",
  "sourceRoot": "tools/monorepo-image",
  "projectType": "application",
  "tags": ["type:app", "scope:ci"],
  "targets": {
    "image": {
      "executor": "@nx-tools/nx-container:build",
      "cache": false,
      "options": {
        "context": ".",
        "file": "tools/monorepo-image/Dockerfile",
        "load": true,
        "push": false,
        "tags": ["monorepo:local"]
      },
      "configurations": {
        "ci-base": {
          "target": "ci-base",
          "tags": ["monorepo:ci-base"]
        },
        "production": {
          "target": "production",
          "tags": ["monorepo:production"]
        }
      }
    },
    "publish": {
      "executor": "@nx-tools/nx-container:build",
      "cache": false,
      "options": {
        "context": ".",
        "file": "tools/monorepo-image/Dockerfile",
        "builder": "${BUILDX_BUILDER}",
        "push": true,
        "provenance": "false",
        "cache-from": ["type=registry,ref=${BRANCH_CACHE}"],
        "cache-to": ["type=registry,ref=${BRANCH_CACHE},mode=max"]
      },
      "configurations": {
        "ci-base": {
          "target": "ci-base",
          "tags": ["${MONOREPO_IMAGE}:ci-base"]
        },
        "production": {
          "target": "production",
          "tags": ["${MONOREPO_IMAGE}:${DOCKER_TAG}"]
        }
      }
    }
  }
}
